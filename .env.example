# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# These two values are PUBLIC by design (protected by Row Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# ---- Server-side only. NEVER put these in .env.local or any VITE_ variable. ----
# Set them as Supabase Edge Function secrets instead:
#   npx supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=gemini-flash-latest
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-flash-latest
